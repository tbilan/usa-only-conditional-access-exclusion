# Multi-tenant app registration created in YOUR (partner) tenant.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value

# Your own bilan.com tenant ID (Entra ID > Overview > Tenant ID).
# Used for SSO sign-in (ONLY accounts from this tenant can sign in) and for "Import from GDAP".
PARTNER_TENANT_ID=00000000-0000-0000-0000-000000000000

# Web port
PORT=3000

# Who can reach the app. Default = this computer only. To share it with the bilan.com team, host it on a
# server, set HOST=0.0.0.0, and set BASE_URL to the address people will type (use https:// via a reverse proxy).
# BASE_URL + /auth/callback must be added as a Web redirect URI on the app registration.
HOST=127.0.0.1
BASE_URL=http://localhost:3000
# TRUST_PROXY=true        # set when running behind a reverse proxy that terminates HTTPS
# SESSION_SECRET=         # optional; otherwise a random one is generated in data/session-secret
# SESSION_HOURS=8
# AUTH_DISABLED=true      # local development only; refused unless HOST=127.0.0.1

# Time zone for "remove after" dates (IANA name). Defaults to this computer's zone; set it on Azure (which runs in UTC).
# APP_TIMEZONE=America/New_York

# Minutes between automatic expiry sweeps
SWEEP_INTERVAL_MINUTES=15
