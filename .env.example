# Multi-tenant app registration created in YOUR (partner) tenant.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value

# Your own (partner/MSP) tenant ID. Only needed for "Import from GDAP".
PARTNER_TENANT_ID=00000000-0000-0000-0000-000000000000

# Local web port (the app only listens on 127.0.0.1)
PORT=3000

# Minutes between automatic expiry sweeps
SWEEP_INTERVAL_MINUTES=15
